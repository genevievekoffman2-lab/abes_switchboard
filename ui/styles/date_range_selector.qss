DateRangeSelector QDateEdit {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 6px 10px;
    min-width: 120px;
}

DateRangeSelector QDateEdit:focus {
    border: 1px solid #1d4ed8;
}

DateRangeSelector QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 24px;
    border-left: 1px solid #dee2e6;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

DateRangeSelector QDateEdit::down-arrow {
    image: url(assets/down-chevron.png);
    width: 12px;
    height: 12px;
}